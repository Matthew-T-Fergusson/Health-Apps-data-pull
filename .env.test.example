# Test-only env for Docker Compose integration tests.
# Do not point this at a live/local production health database.

APP_ENV=test
WORKSPACE_DIR=.

PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=health_ops_test
PGUSER=health_test
PGPASSWORD=health_test_password
POSTGRES_PASSWORD=health_test_password

# Provider credentials are intentionally dummy values; integration tests here
# exercise DB bootstrap/schema behavior, not external Garmin/Strava APIs.
STRAVA_CLIENT_ID=test
STRAVA_CLIENT_SECRET=test
STRAVA_REFRESH_TOKEN=test
STRAVA_TOKEN_EXPIRES_AT=

GARMIN_EMAIL=test@example.invalid
GARMIN_PASSWORD=test
GARMIN_TOKENSTORE_DIR=./output/test/garmin/tokenstore
GARMIN_LOCKOUT_STATE_PATH=./output/test/garmin/lockout_state.json
GARMIN_LOCKOUT_COOLDOWN_SECONDS=43200

GARMIN_SYNC_DAYS=7
GARMIN_ACTIVITY_LOOKBACK_DAYS=60
GARMIN_ACTIVITY_DETAIL_LOOKBACK_DAYS=90
GARMIN_READINESS_DAYS=120

HEALTH_QA_WARN_HOURS=8
HEALTH_QA_FAIL_HOURS=24
LOG_LEVEL=INFO
