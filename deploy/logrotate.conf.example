# Health Apps Data Pull - logrotate example
#
# Friend/default repo-local log path. Copy/adapt to /etc/logrotate.d/health-sync if desired.
# This rotates scheduler logs weekly and keeps eight weeks.

/opt/health-apps-data-pull/logs/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}

# If you move to production-style logs, use something like:
# /var/log/health-sync/*.log {
#     weekly
#     rotate 8
#     missingok
#     notifempty
#     compress
#     delaycompress
#     copytruncate
# }
