[Unit]
Description=Personal Health Data Platform one-shot sync
Documentation=https://github.com/Matthew-T-Fergusson/personal-health-data-platform
Wants=network-online.target
After=network-online.target postgresql.service docker.service

[Service]
Type=oneshot
# Replace this with the user that owns the checkout and virtualenv.
User=healthsync
Group=healthsync
WorkingDirectory=/opt/personal-health-data-platform

# Friend/default path: repo-local .env. Hardened alternative: /etc/health-sync/health-sync.env.
Environment=ENV_PATH=/opt/personal-health-data-platform/.env
# EnvironmentFile=/etc/health-sync/health-sync.env

# Keep state/artifacts repo-local for the simple handoff path.
ExecStart=/opt/personal-health-data-platform/scripts/health_primary_sync_safe.sh

# Basic hardening that still allows repo-local output/tokenstore writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/personal-health-data-platform/output /opt/personal-health-data-platform/logs

[Install]
WantedBy=multi-user.target
